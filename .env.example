# copy to .env and fill in - .env is NOT committed
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=atlas
TZ=Africa/Cairo
JWT_SECRET=
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=

# Broker provisioning: use dynsec for the finished deployment after running
# ./tools/migrate_dynsec.sh and saving the generated admin credentials below.
BROKER_PROVISIONING=dynsec
DYNSEC_ADMIN_USER=
DYNSEC_ADMIN_PASSWORD=

# Service/device MQTT credentials used by tools/dynsec_seed.sh.
MQTT_INGEST_USER=atlas_ingest
MQTT_INGEST_PASSWORD=
MQTT_API_USER=atlas_api
MQTT_API_PASSWORD=
MQTT_SIM01_USER=atlas-sim-01
MQTT_SIM01_PASSWORD=

# MQTT_API_USER and MQTT_API_PASSWORD are also used by the API to publish
# retained device configuration downlinks.

# Email-only account verification and password recovery.
# Use console for local development; set EMAIL_DEV_LOG_CODE=true only locally.
# For real delivery use smtp and fill the SMTP values below.
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
EMAIL_DEV_LOG_CODE=false
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5
